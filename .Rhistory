library(caret)
# Định nghĩa cross-validation
train_control <- trainControl(method = "cv", number = 10)  # 10-fold cross-validation
# Áp dụng cross-validation cho mô hình GAM
m_value_non_tech_gam_cv <- train(value ~ age + s(overall) + s(wage) + s(international_reputation, k = 5) + release_clause,
data = dataset,
method = "gam",  # Sử dụng mô hình GAM
trControl = train_control)  # Định nghĩa phương pháp cross-validation
set.seed(123)  # Để đảm bảo kết quả có thể tái tạo
# Chia tập dữ liệu theo tỷ lệ 70% train, 30% test
train_index <- sample(1:nrow(dataset), 0.7 * nrow(dataset))
train_data <- dataset[train_index, ]
test_data <- dataset[-train_index, ]
set.seed(123)  # Để đảm bảo kết quả có thể tái tạo
# Chia tập dữ liệu theo tỷ lệ 70% train, 30% test
train_index <- sample(1:nrow(dataset), 0.7 * nrow(dataset))
train_data <- dataset[train_index, ]
test_data <- dataset[-train_index, ]
# Dự đoán giá trị trên tập kiểm tra
predictions_m_value_non_tech_gam <- predict(m_value_non_tech_gam, newdata = test_data)
# Đánh giá mô hình: tính R-squared (R²) và RMSE (Root Mean Squared Error)
library(Metrics)
# Tính R² và RMSE
r_squared <- 1 - sum((test_data$value - predictions)^2) / sum((test_data$value - mean(test_data$value))^2)
# Dự đoán giá trị trên tập kiểm tra
predictions_gam <- predict(m_value_non_tech_gam, newdata = test_data)
# Đánh giá mô hình: tính R-squared (R²) và RMSE (Root Mean Squared Error)
library(Metrics)
# Tính R² và RMSE
r_squared <- 1 - sum((test_data$value - predictions_gam)^2) / sum((test_data$value - mean(test_data$value))^2)
rmse_value <- rmse(test_data$value, predictions_gam)
# In kết quả đánh giá
cat("R-squared: ", r_squared, "\n")
cat("RMSE: ", rmse_value, "\n")
mean_value <- mean(dataset$value)
rmse_ratio <- rmse_value / mean_value
cat("RMSE/Mean: ", rmse_ratio, "\n")
# Số lượng giá trị bằng 0
num_zeros <- sum(dataset$value == 0)
# Tổng số giá trị
total_values <- length(dataset$value)
# Tính tỷ lệ phần trăm
percent_zeros <- (num_zeros / total_values) * 100
percent_zeros
# giữ lại dataset ứng với value khác 0
dataset_glm <- subset(dataset, value != 0)
# family: kiểu phân phối
# link: hàm liên kết mặc định, "identity" : hồi quy tuyến tính
m_value_non_tech_glm <- glm(value ~ age + overall + wage + international_reputation
+ release_clause, family = Gamma(link = "log"), data = dataset_glm)
summary(m_value_non_tech_glm)
ggplot(data = m_value_non_tech_glm, mapping = aes(x = .fitted, y = .resid)) +
geom_point() +
geom_smooth(method = "loess", se = FALSE) +
geom_hline(yintercept = 0, linetype = "dashed") +
labs(x = "Fitted values", y = "Residuals") +
theme_bw()
ggplot(m_value_non_tech_glm, aes(.fitted, sqrt(abs(.stdresid)))) +
geom_point(na.rm = TRUE) +
geom_smooth(method = "loess", na.rm = TRUE, se = FALSE) +
labs(x = "Fitted Values", y = expression(sqrt("|Standardized residuals|"))) +
theme_bw()
