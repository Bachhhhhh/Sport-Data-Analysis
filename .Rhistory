xlab("Leverage") + ylab("Standardized Residuals") +
scale_size_continuous("Cook's Distance", range = c(1, 6)) +
theme_bw() +
theme(legend.position = "bottom")
# kiểm tra hiện tượng đa cộng tuyến
library(car)
vif(m_value_non_tech)
# ---- 4. Mở rộng mô hình ----
# Ta xem xét mở rộng mô hình bằng 2 phương pháp:
# + GAM: mô hình cộng tính tổng quát
# + GLM: mô hình tổng quát
# ---- Phương pháp GAM ----
# Dữ liệu chỉ có 5 biến quan sát nên ta có thể sử dụng GAM cho một vài biến trong mô hình
# GAM đặc biệt hiệu quả khi biểu diễn cả mối quan hệ tuyến tính và phi tuyến
# tính hệ số ước lượng của tất cả các biến
terms_m_value_non_tech <- predict(m_value_non_tech, type = "terms")
# thặng dư từng phần của tất cả các biến
partial_resid_m_value_non_tech <- residuals(m_value_non_tech, type = "partial")
# age
data_part_resid_age <- tibble(
age = dataset$age,
terms_age = terms_m_value_non_tech[, "age"],
partial_resid_age = partial_resid_m_value_non_tech[, "age"]
)
ggplot(data_part_resid_age, mapping = aes(age, partial_resid_age)) +
geom_point() +
geom_smooth(method = "loess", se = FALSE, linetype = "dashed",
color = "forestgreen") +
geom_line(aes(x = age, y = terms_age), color = "blue") +
labs(x = "Age", y = "Partial Residuals") +
theme_bw()
# overall
data_part_resid_overall <- tibble(
overall = dataset$overall,
terms_overall = terms_m_value_non_tech[, "overall"],
partial_resid_overall = partial_resid_m_value_non_tech[, "overall"]
)
ggplot(data_part_resid_overall, mapping = aes(overall, partial_resid_overall)) +
geom_point() +
geom_smooth(method = "loess", se = FALSE, linetype = "dashed",
color = "forestgreen") +
geom_line(aes(x = overall, y = terms_overall), color = "blue") +
labs(x = "Overall", y = "Partial Residuals") +
theme_bw()
# wage
data_part_resid_wage <- tibble(
wage = dataset$wage,
terms_wage = terms_m_value_non_tech[, "wage"],
partial_resid_wage = partial_resid_m_value_non_tech[, "wage"]
)
ggplot(data_part_resid_wage, mapping = aes(wage, partial_resid_wage)) +
geom_point() +
geom_smooth(method = "loess", se = FALSE, linetype = "dashed",
color = "forestgreen") +
geom_line(aes(x = wage, y = terms_wage), color = "blue") +
labs(x = "Wage", y = "Partial Residuals") +
theme_bw()
# international_reputation
# đây là biến rời rạc
data_part_resid_inter_rep <- tibble(
inter_rep = dataset$international_reputation,
terms_inter_rep = terms_m_value_non_tech[, "international_reputation"],
partial_resid_inter_rep = partial_resid_m_value_non_tech[, "international_reputation"]
)
ggplot(data_part_resid_inter_rep, mapping = aes(inter_rep, partial_resid_inter_rep)) +
geom_point() +
geom_smooth(method = "loess", se = FALSE, linetype = "dashed",
color = "forestgreen", span = 1) +
geom_line(aes(x = inter_rep, y = terms_inter_rep), color = "blue") +
labs(x = "International Reputation", y = "Partial Residuals") +
theme_bw()
# release_clause
data_part_resid_rel_cl <- tibble(
rel_cl = dataset$release_clause,
terms_rel_cl = terms_m_value_non_tech[, "release_clause"],
partial_resid_rel_cl = partial_resid_m_value_non_tech[, "release_clause"]
)
ggplot(data_part_resid_rel_cl, mapping = aes(rel_cl, partial_resid_rel_cl)) +
geom_point() +
geom_smooth(method = "loess", se = FALSE, linetype = "dashed",
color = "forestgreen") +
geom_line(aes(x = rel_cl, y = terms_rel_cl), color = "blue") +
labs(x = "Release Clause", y = "Partial Residuals") +
theme_bw()
# ta áp dụng GAM cho overal và wage
library(mgcv)
m_value_non_tech_gam = gam(value ~ age + s(overall) + s(wage) + s(international_reputation, k = 5)# maximum of degree
+ release_clause, data = dataset)
summary(m_value_non_tech_gam)
# tính hệ số ước lượng cho từng biến
terms_m_value_non_tech_gam <- predict(m_value_non_tech_gam, type = "terms")
# tính thặng dư từng phần
partial_resid_m_value_non_tech_gam <- residuals(m_value_non_tech_gam, type = "working") + terms_m_value_non_tech_gam
library(mgcViz)
# vẽ hàm trơn được ước lượng
viz_m_value_non_tech_gam <- getViz(m_value_non_tech_gam)
print(plot(viz_m_value_non_tech_gam, allTerms = T), pages = 1)
# ---- Phương pháp GLM ----
# sử dụng GLM cho ta 2 lợi ích sau:
# + giải quyết được các điểm ngoại lai
# + giải quyết được vấn đề phương sai không đồng nhất
# trong phần EDA, ta dễ dàng thấy dữ liệu của value bị lệch phải rất nhiều và trong phần chẩn đoán mô hình, đồ thị cho ta thấy phương sai không đồng nhất
# áp dụng GLM bằng cách sử dụng phân phối Gamma cho biến phản hồi Y sẽ giải quyết được các vấn đề trên
m_value_non_tech_glm <- glm(value ~ age + overall + wage + international_reputation
+ release_clause, family = Gamma(link = "identity"), data = dataset)
min(dataset$value)
