# Định nghĩa cross-validation
train_control <- trainControl(method = "cv", number = 10)  # 10-fold cross-validation
# Áp dụng cross-validation cho mô hình GAM
m_value_non_tech_gam_cv <- train(value ~ age + s(overall) + s(wage) + international_reputation + release_clause,
data = dataset,
method = "gam",  # Sử dụng mô hình GAM
trControl = train_control)  # Định nghĩa phương pháp cross-validation
# ta áp dụng GAM cho overal và wage
library(mgcv)
m_value_non_tech_gam = gam(value ~ age + s(overall) + s(wage) + s(international_reputation, k = 5)# maximum degree of freedom
+ release_clause, data = dataset)
summary(m_value_non_tech_gam)
# tính hệ số ước lượng cho từng biến
terms_m_value_non_tech_gam <- predict(m_value_non_tech_gam, type = "terms")
# tính thặng dư từng phần
partial_resid_m_value_non_tech_gam <- residuals(m_value_non_tech_gam, type = "working") + terms_m_value_non_tech_gam
library(mgcViz)
# vẽ hàm trơn được ước lượng
viz_m_value_non_tech_gam <- getViz(m_value_non_tech_gam)
print(plot(viz_m_value_non_tech_gam, allTerms = T), pages = 1)
