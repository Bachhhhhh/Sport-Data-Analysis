library(janitor)
library(leaps)
library(tidyverse)
library(ggplot2)
library(car)
#load data
file_path <- "D:/Duy/Năm 3/Xử lý SLTK/Project nhóm (CK)/fifa_eda_stats.csv"
data <- read_csv(file = file_path, na = c("", "NA", "N/A")) |> clean_names()
#change type currency
currency_to_numeric <- function(x) {
x <- gsub("€", "", x)
x <- gsub("M", "e6", x)
x <- gsub("K", "e3", x)
return(as.numeric(eval(parse(text = x))))
}
data$value <- sapply(data$value, currency_to_numeric)
data$wage <- sapply(data$wage, currency_to_numeric)
data$release_clause <- sapply(data$release_clause, currency_to_numeric)
#fix height, weight
data$height <- as.numeric(gsub("'", ".", data$height))
data$weight <- as.numeric(gsub("lbs", "", data$weight))
#drop unnecessary columns
columns_to_drop <- c("loaned_from", "id", "jersey_number", "joined")
data <- data %>% select(-all_of(columns_to_drop))
#fill by mean
data <- data %>%
mutate(across(everything(), ~ifelse(is.na(.), mean(., na.rm = TRUE), .)))
#create role columns: foward, midfielder, defender, goalkeeper
data$role <- ifelse(data$position %in% c("RF", "ST", "LW", "LF", "RS", "LS", "CF", "RW"), "Forward",
ifelse(data$position %in% c("RCM", "LCM", "RM", "LM", "LAM", "CAM", "CDM", "RDM", "LDM", "CM", "RAM"), "Midfielder",
ifelse(data$position %in% c("RCB", "CB", "LCB", "LB", "RB", "RWB", "LWB"), "Defender",
ifelse(data$position == "GK", "Goalkeeper", NA))))
#filter players have no role
data <- data %>%
filter(!is.na(role))
#create column total = wage + value
data$total <- data$wage + data$value
GK_data <- data %>%
filter(role == "Goalkeeper")
m_GK <- lm(overall ~ gk_diving + gk_handling + gk_positioning + gk_reflexes + gk_kicking, GK_data)
vif(m_GK)
m_GK <- lm(overall ~ gk_handling + gk_positioning + gk_reflexes + gk_kicking, GK_data)
vif(m_GK)
ggplot(GK_data, aes(x = overall)) +
geom_histogram(aes(y = ..density..), bins = 30, color = "black", fill = "yellow", alpha = 1) +
geom_density(alpha = 0.6, color = "red", linewidth = 1) +
labs(title = "Distribution of Overall Ratings", x = "Overall", y = "Frequency")
ggplot(data = m_GK, mapping = aes(x = .fitted, y = .resid)) +
geom_point() +
geom_smooth(method = "loess", se = FALSE) +
geom_hline(yintercept = 0, linetype = "dashed") +
labs(x = "Fitted values", y = "Residuals") +
theme_bw()
ggplot(data = m_GK, mapping = aes(x = .fitted, y = sqrt(abs(.stdresid)))) +
geom_point(na.rm = TRUE) +
geom_smooth(method = "loess", se = FALSE, na.rm = TRUE) +
labs(x = "Fitted Values", y = expression(sqrt("|Standardized residuals|"))) +
theme_bw()
m_GK_GLM <- glm(overall ~ gk_handling + gk_positioning + gk_reflexes + gk_kicking, GK_data,
family = Gamma(link = "identity"))
ggplot(data = m_GK_GLM, mapping = aes(x = .fitted, y = .resid)) +
geom_point() +
geom_smooth(method = "loess", se = FALSE) +
geom_hline(yintercept = 0, linetype = "dashed") +
labs(x = "Fitted values", y = "Residuals") +
theme_bw()
ggplot(data = m_GK_GLM, mapping = aes(x = .fitted, y = sqrt(abs(.stdresid)))) +
geom_point(na.rm = TRUE) +
geom_smooth(method = "loess", se = FALSE, na.rm = TRUE) +
labs(x = "Fitted Values", y = expression(sqrt("|Standardized residuals|"))) +
theme_bw()
